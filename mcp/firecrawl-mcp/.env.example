FIRECRAWL_MCP_BASE_URL=https://firecrawl.{your-domain}
FIRECRAWL_MCP_GITHUB_CLIENT_ID=REPLACE_ME
FIRECRAWL_MCP_GITHUB_CLIENT_SECRET=REPLACE_ME
FIRECRAWL_MCP_GITHUB_USERS=your-github-login,another-approved-login
FIRECRAWL_MCP_JWT_SIGNING_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
FIRECRAWL_MCP_STORAGE_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_32
FIRECRAWL_MCP_REDIS_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32
FIRECRAWL_API_KEY=REPLACE_ME
# Optional. Concurrent firecrawl subprocesses; raise only alongside mem_limit/pids_limit.
# FIRECRAWL_MCP_MAX_CONCURRENCY=8
# Optional. Set to 0 to disable the background CLI update check entirely.
# FIRECRAWL_MCP_UPDATE_CHECK=1
