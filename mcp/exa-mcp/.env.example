EXA_MCP_BASE_URL=https://exa.{your-domain}
EXA_MCP_GITHUB_CLIENT_ID=REPLACE_ME
EXA_MCP_GITHUB_CLIENT_SECRET=REPLACE_ME
EXA_MCP_GITHUB_USERS=your-github-login,another-approved-login
EXA_MCP_JWT_SIGNING_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
EXA_MCP_STORAGE_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_32
EXA_MCP_REDIS_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32
EXA_API_KEY=REPLACE_ME
# Optional. Static bearer tokens for clients that cannot run the OAuth flow --
# Trae is the main one: its MCP client never opens a browser and cannot refresh
# a token, so static headers are its only option. Format: `github-login:token`,
# comma-separated, where each login must also appear in EXA_MCP_GITHUB_USERS.
# Tokens must be at least 32 characters; generate with `openssl rand -hex 32`.
# These do not expire -- rotate them by editing this line and recreating the
# container. Leave unset to allow OAuth only.
# EXA_MCP_STATIC_TOKENS=your-github-login:REPLACE_WITH_OPENSSL_RAND_HEX_32
# Optional. Concurrent upstream Exa calls; callers queue rather than fail.
# EXA_MCP_MAX_CONCURRENCY=8
# Optional. Which upstream tools to expose, comma-separated. Defaults to Exa's
# full surface. Drop agent_run to disable the usage-billed agent tool.
# EXA_MCP_UPSTREAM_TOOLS=web_search_exa,web_fetch_exa,agent_run,web_search_advanced_exa
# Optional. Upstream endpoint, without a query string. Defaults to Exa's hosted
# server; only change this to point at a self-hosted exa-mcp-server.
# EXA_MCP_UPSTREAM_URL=https://mcp.exa.ai/mcp
# Optional. Set to 0 to skip the boot-time upstream/API-key check.
# EXA_MCP_BOOT_PROBE=1
