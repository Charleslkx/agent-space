# Static bearer mode (for clients that support custom Authorization headers)
LARK_MCP_AUTH_TOKEN=
# Preferred on servers: a 0600 file created and owned by the service user
LARK_MCP_AUTH_TOKEN_FILE=/var/lib/lark-markdown/auth.token

# ChatGPT and Claude/GitHub OAuth mode
LARK_MCP_AUTH_MODE=github
LARK_MCP_BASE_URL=https://lark-markdown.{your-domain}
LARK_MCP_GITHUB_CLIENT_ID=
LARK_MCP_GITHUB_CLIENT_SECRET=
LARK_MCP_GITHUB_USERS=
# Generate with: openssl rand -hex 32
LARK_MCP_JWT_SIGNING_KEY=
