LARK_MCP_AUTH_MODE=github
LARK_MCP_BASE_URL=https://lark-doc.example.com
LARK_MCP_GITHUB_CLIENT_ID=your-client-id
LARK_MCP_GITHUB_CLIENT_SECRET=your-client-secret
LARK_MCP_GITHUB_USERS=your-github-login
LARK_MCP_JWT_SIGNING_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
# Optional alternative: set AUTH_MODE=token and use only a service-owned 0600 file.
# LARK_MCP_AUTH_TOKEN_FILE=/var/lib/lark-doc/auth.token
