BRAVE_MCP_BASE_URL=https://brave.{your-domain}
BRAVE_MCP_GITHUB_CLIENT_ID=REPLACE_ME
BRAVE_MCP_GITHUB_CLIENT_SECRET=REPLACE_ME
BRAVE_MCP_GITHUB_USERS=your-github-login,another-approved-login
BRAVE_MCP_JWT_SIGNING_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
BRAVE_MCP_STORAGE_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_32
BRAVE_MCP_REDIS_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32
BRAVE_SEARCH_API_KEY=REPLACE_ME
# Optional. Concurrent bx subprocesses; raise only alongside mem_limit/pids_limit.
# BRAVE_MCP_MAX_CONCURRENCY=16
