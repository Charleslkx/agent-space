#!/bin/sh
set -eu

if [ -n "${CODEX_SHARED_CLI:-}" ]; then
  codex_cli=$CODEX_SHARED_CLI
elif [ -x "${HOME}/.local/bin/codex" ]; then
  codex_cli=${HOME}/.local/bin/codex
elif [ -x "${HOME}/.codex/packages/standalone/current/bin/codex" ]; then
  codex_cli=${HOME}/.codex/packages/standalone/current/bin/codex
elif command -v codex >/dev/null 2>&1; then
  codex_cli=$(command -v codex)
else
  echo "Shared Codex daemon: could not find the codex CLI" >&2
  echo "Set CODEX_SHARED_CLI to the absolute path of a compatible codex executable." >&2
  exit 127
fi

# Starting a managed daemon reports an error when Codex Desktop already owns
# the control socket. That is expected: the proxy below can reuse that server.
"$codex_cli" app-server daemon start >/dev/null 2>&1 || true

exec "$codex_cli" app-server proxy
